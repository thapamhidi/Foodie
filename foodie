<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Foodie</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:#f8fafc;
    color:#1e293b;
}

header{
    background:white;
    position:sticky;
    top:0;
    z-index:1000;
    box-shadow:0 2px 10px rgba(0,0,0,.08);
}

.navbar{
    max-width:1200px;
    margin:auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:18px 20px;
}

.logo{
    font-size:1.7rem;
    font-weight:700;
    color:#ff5a1f;
}

.nav-links{
    display:flex;
    gap:25px;
}

.nav-links a{
    text-decoration:none;
    color:#334155;
    font-weight:500;
}

.login-btn{
    background:#ff5a1f;
    color:white;
    border:none;
    padding:10px 20px;
    border-radius:10px;
    cursor:pointer;
}

.hero{
    min-height:85vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    background:linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,.45)),
    url('https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=1600&q=80');
    background-size:cover;
    background-position:center;
    color:white;
    padding:20px;
}

.hero-content h1{
    font-size:3.5rem;
    margin-bottom:15px;
}

.hero-content p{
    font-size:1.1rem;
    margin-bottom:30px;
}

.search-box{
    display:flex;
    max-width:700px;
    margin:auto;
    background:white;
    border-radius:15px;
    overflow:hidden;
}

.search-box input{
    flex:1;
    border:none;
    padding:18px;
    font-size:1rem;
    outline:none;
}

.search-box button{
    border:none;
    background:#ff5a1f;
    color:white;
    padding:18px 28px;
    cursor:pointer;
}

.section{
    max-width:1200px;
    margin:auto;
    padding:80px 20px;
}

.section-title{
    text-align:center;
    font-size:2rem;
    margin-bottom:40px;
}

.categories{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:20px;
}

.category{
    background:white;
    padding:30px;
    text-align:center;
    border-radius:16px;
    box-shadow:0 3px 15px rgba(0,0,0,.06);
    transition:.3s;
    cursor:pointer;
}

.category:hover{
    transform:translateY(-5px);
}

.category span{
    font-size:2.5rem;
}

.restaurants{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:25px;
}

.card{
    background:white;
    border-radius:16px;
    overflow:hidden;
    box-shadow:0 4px 15px rgba(0,0,0,.08);
}

.card img{
    width:100%;
    height:220px;
    object-fit:cover;
}

.card-body{
    padding:20px;
}

.card h3{
    margin-bottom:10px;
}

.rating{
    color:#f59e0b;
    margin-bottom:8px;
}

.order-btn{
    width:100%;
    margin-top:15px;
    padding:12px;
    border:none;
    background:#ff5a1f;
    color:white;
    border-radius:10px;
    cursor:pointer;
}

.app-section{
    background:#ff5a1f;
    color:white;
    border-radius:25px;
    text-align:center;
    padding:60px 30px;
}

.store-buttons{
    margin-top:20px;
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
}

.store-buttons button{
    padding:12px 22px;
    border:none;
    border-radius:10px;
    cursor:pointer;
    font-weight:600;
}

footer{
    background:#0f172a;
    color:white;
    text-align:center;
    padding:25px;
}

.cart{
    position:fixed;
    bottom:20px;
    right:20px;
    background:#ff5a1f;
    color:white;
    padding:15px 22px;
    border-radius:50px;
    font-weight:600;
    box-shadow:0 10px 25px rgba(0,0,0,.25);
}

@media(max-width:768px){

.hero-content h1{
    font-size:2.3rem;
}

.nav-links{
    display:none;
}

.search-box{
    flex-direction:column;
}

.search-box button{
    width:100%;
}
}
</style>
</head>
<body>

<header>
    <div class="navbar">
        <div class="logo">Foodie</div>

        <div class="nav-links">
            <a href="#">Home</a>
            <a href="#">Restaurants</a>
            <a href="#">Groceries</a>
            <a href="#">Offers</a>
            <a href="#">Contact</a>
        </div>

        <button class="login-btn">Login</button>
    </div>
</header>

<section class="hero">
    <div class="hero-content">
        <h1>Order Food & Groceries Online</h1>
        <p>Fast delivery from your favorite restaurants</p>

        <div class="search-box">
            <input type="text" placeholder="Search food, restaurant, grocery...">
            <button onclick="searchFood()">Search</button>
        </div>
    </div>
</section>

<section class="section">
    <h2 class="section-title">Popular Categories</h2>

    <div class="categories">
        <div class="category">
            <span>🍔</span>
            <h3>Burger</h3>
        </div>

        <div class="category">
            <span>🍕</span>
            <h3>Pizza</h3>
        </div>

        <div class="category">
            <span>🥗</span>
            <h3>Healthy</h3>
        </div>

        <div class="category">
            <span>🍜</span>
            <h3>Momo</h3>
        </div>

        <div class="category">
            <span>🛒</span>
            <h3>Groceries</h3>
        </div>
    </div>
</section>

<section class="section">
    <h2 class="section-title">Featured Restaurants</h2>

    <div class="restaurants">

        <div class="card">
            <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=1000&q=80">
            <div class="card-body">
                <h3>Pizza House</h3>
                <p class="rating">⭐ 4.8</p>
                <p>30-40 min delivery</p>
                <button class="order-btn" onclick="addToCart('Pizza')">
                    Order Now
                </button>
            </div>
        </div>

        <div class="card">
            <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=1000&q=80">
            <div class="card-body">
                <h3>Burger Point</h3>
                <p class="rating">⭐ 4.7</p>
                <p>25-35 min delivery</p>
                <button class="order-btn" onclick="addToCart('Burger')">
                    Order Now
                </button>
            </div>
        </div>

        <div class="card">
            <img src="https://images.unsplash.com/photo-1626804475297-41608ea09aeb?auto=format&fit=crop&w=1000&q=80">
            <div class="card-body">
                <h3>Momo Station</h3>
                <p class="rating">⭐ 4.9</p>
                <p>20-30 min delivery</p>
                <button class="order-btn" onclick="addToCart('Momo')">
                    Order Now
                </button>
            </div>
        </div>

    </div>
</section>

<section class="section">
    <div class="app-section">
        <h2>Download Our Mobile App</h2>
        <p>Get faster ordering and exclusive discounts.</p>

        <div class="store-buttons">
            <button>Google Play</button>
            <button>App Store</button>
        </div>
    </div>
</section>

<footer>
    © 2026 Foodie | All Rights Reserved
</footer>

<div class="cart" id="cart">
    🛒 Cart (0)
</div>

<script>
let cartCount = 0;

function addToCart(item){
    cartCount++;
    document.getElementById("cart").innerHTML =
    `🛒 Cart (${cartCount})`;

    alert(item + " added to cart!");
}

function searchFood(){
    const text =
    document.querySelector("input").value;

    if(text.trim()===""){
        alert("Please enter a search term.");
        return;
    }

    alert("Searching for: " + text);
}
</script>

</body>
</html>